# Secrets — real credentials live in these per-service .env files on the
# server; never in git. Deployment reads them via docker-compose's env_file:.
.env
.env.*
!.env.example

# Laravel — installed fresh at image build time (Dockerfile runs `composer
# create-project` + `composer require`), and these are runtime-generated.
laravel-backend/vendor/
laravel-backend/storage/logs/*.log
laravel-backend/storage/framework/cache/*
laravel-backend/storage/framework/sessions/*
laravel-backend/storage/framework/views/*
!laravel-backend/storage/framework/*/.gitkeep
laravel-backend/bootstrap/cache/*.php

# Python
# Compiled Python, anywhere in the tree. Two .pyc files had been committed
# under python-ai-service before these patterns existed; keeping the rules
# unscoped means a new directory cannot reintroduce them.
__pycache__/
*.py[cod]
*$py.class
python-ai-service/**/__pycache__/
python-ai-service/**/*.pyc
python-ai-service/.venv/

# Node — only used for the WordPress plugin's widget test harness
# (wordpress-plugin/haman-ai-chatbot/tests/), installed fresh via `npm
# install`, never a runtime dependency of the plugin itself.
node_modules/

# Editors / OS
.DS_Store
.idea/
.vscode/
---
# Claude Code local tool settings — not app source
.claude/
---
# Stray local scratch files — not part of the app; the first one
# contains what looks like a live API key, never commit it
New Text Document.txt
VECTOR_DIM_PATCH.txt

# Local scratch space used to build and visually check the brand assets
# (Playwright screenshots, draft SVGs, downloaded font sources) — the
# finished files it produced live under laravel-backend/{resources,public}/,
# this directory is the workbench, not a deliverable.
.tools/

# Bind-mounted into laravel/horizon/scheduler at ./logs:/var/www/html/storage/logs
# (see docker-compose.yml and deploy/logrotate/haman-laravel) — runtime
# output, never a deliverable, and `docker compose up` will happily create
# this directory locally too.
/logs/
