# Every variable this platform reads, with no values.
#
# Copy the sections into the three real files, which are never committed:
#
#   .env                      read by docker-compose itself
#   laravel-backend/.env      read by the laravel, horizon and scheduler services
#   python-ai-service/.env    read by the python_ai service
#
# docker-compose refuses to start when DB_PASSWORD or REDIS_PASSWORD is
# missing or empty, rather than bringing the database and cache up with no
# password. An empty password is worse than a leaked one, because nothing
# looks wrong.
#
# Several values must be identical in more than one file. Those are marked
# "same as" below; when they drift, the failure is silent. That is not
# hypothetical: the encryption key is read by both sides, and when only one
# of them was renamed the other fell back to passing the still-encrypted
# value along as if it were a key.


# ─────────────────────────────────────────────────────────────────────
# .env  (project root — docker-compose interpolates these)
# ─────────────────────────────────────────────────────────────────────

# The Postgres superuser password. Also laravel-backend/.env's DB_PASSWORD
# and the password inside python-ai-service/.env's DATABASE_URL.
DB_PASSWORD=

# The Redis password. Also laravel-backend/.env's REDIS_PASSWORD and the
# password inside python-ai-service/.env's REDIS_URL.
REDIS_PASSWORD=


# ─────────────────────────────────────────────────────────────────────
# laravel-backend/.env
# ─────────────────────────────────────────────────────────────────────

APP_NAME=
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# The public URL. Changing this is all the landing page, robots.txt,
# sitemap.xml and the link-preview card need to follow a new domain.
APP_URL=
APP_TIMEZONE=

LOG_CHANNEL=
LOG_LEVEL=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
# same as .env's DB_PASSWORD
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PORT=6379
# same as .env's REDIS_PASSWORD
REDIS_PASSWORD=

AI_SERVICE_URL=
# same as python-ai-service/.env's INTERNAL_SECRET
AI_SERVICE_SECRET=

GEMINI_API_KEY=

MAIL_MAILER=

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

SANCTUM_STATEFUL_DOMAINS=

# The plugin version the platform advertises as current. Preflight checks
# this against the plugin's own header, so it cannot drift unnoticed.
HAMAN_WP_PLUGIN_LATEST_VERSION=


# ─────────────────────────────────────────────────────────────────────
# python-ai-service/.env
# ─────────────────────────────────────────────────────────────────────

APP_ENV=production
LOG_LEVEL=

# same as laravel-backend/.env's AI_SERVICE_SECRET
INTERNAL_SECRET=

# postgresql://<user>:<DB_PASSWORD>@postgres:5432/<database>
DATABASE_URL=
# redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_DIMS=
GEMINI_CHAT_MODEL=

GROQ_API_KEY=

# base64 of 32 random bytes. The LLM provider API keys are stored encrypted
# in the database with this, and both languages must hold the same value:
# App\Support\LlmKeyCrypto writes with it, llm_provider_service reads with
# it. If it is missing the read falls back to returning the ciphertext
# unchanged, and the provider answers 401 with nothing in the logs to say
# why. Note the spelling -- one "m".
HAMAN_ENCRYPTION_KEY=
